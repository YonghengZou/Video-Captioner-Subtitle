# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Secrets
.env
.env.*
!.env.example

# Source videos (large media, keep out of git; keep folder placeholder)
videos_en/*
!videos_en/.gitkeep
videos_zh/*
!videos_zh/.gitkeep

# Generated media (fully ignored)
images/

# Burned output (keep folder placeholder)
burned/*
!burned/.gitkeep

# Config / working files (keep folders, ignore content)
.kilo/
scripts/*
!scripts/.gitkeep
subtitles/*
!subtitles/.gitkeep

# macOS
.DS_Store
